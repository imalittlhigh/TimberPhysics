#debug
tellraw @a[tag=atimber.debug] [{"text":"Timber-Debug:","color":"yellow"},{"text":" Summoning Dark Oak Leaf","color":"white"}]

#this is all the same, so im only gonna comment one
#summonging falling blocks, with correcnt falling direction and motion depending on the height they are on the tree. also it has a marker for spawning the correct loot if the falling block pops
execute as @s[scores={atimber.hight=0..1}] if data storage atimber:fall {dir:"south"} run summon falling_block ~ ~ ~ {BlockState:{Name:"minecraft:dark_oak_leaves",Properties:{persistent:"false"}},NoGravity:0b,Time:1,DropItem:1b,HurtEntities:0b,Motion:[0.0,0.0,0.1],Passengers:[{id:"minecraft:marker",NoGravity:1b,Tags:["atimber.marker.loot","atimber.marker","atimber.marker.dark_oak_loot"]}]}
